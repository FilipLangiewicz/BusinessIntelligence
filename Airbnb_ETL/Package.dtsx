                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE Dim_Weather
SET 
    avg_temp = ?, 
    max_temp = ?, 
    min_temp = ?, 
    daily_will_it_rain = ?, 
    daily_will_it_snow = ?, 
    daily_chance_of_rain = ?, 
    daily_chance_of_snow = ?, 
    sunrise = ?, 
    sunset = ?, 
    last_modified_date = ?
